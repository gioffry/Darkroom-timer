''')
for sid, s in sources.items():
    cur.execute('INSERT OR REPLACE INTO catalog_sources VALUES(?,?,?,?,?,?)', (
        sid, s.get('author',''), s.get('title',''), s.get('url',''),
        s.get('sourceType',''), s.get('verificationStatus','')))

for r in records:
    name = str(r.get('name','')).strip()
    if not name: continue
    cats = arr(r.get('categories'))
    roles = 0
    for c in cats: roles |= ROLE_MAP.get(c,0)
    if roles == 0: continue
    tech = r.get('technical') if isinstance(r.get('technical'), dict) else {}
    aliases = arr(r.get('aliases'))
    film_d = first_list(tech,'filmDilutions')
    paper_d = first_list(tech,'paperDilutions')
    generic_d = first_list(tech,'dilutions')
    if not film_d and ('FILM_DEVELOPER' in cats): film_d = generic_d
    if not paper_d and ('PAPER_DEVELOPER' in cats): paper_d = generic_d
    working = str(tech.get('workingDilution') or tech.get('workingSolution') or '').strip()
    if not working and (('STOP_BATH' in cats) or ('FIXER' in cats)) and generic_d:
        working = generic_d[0]
    physical = str(tech.get('physicalState') or tech.get('state') or '').strip()
    stock = bool(tech.get('stockPreparation') or tech.get('requiresStockPreparation') or False)
    if not stock and any(str(x).lower() == 'stock' for x in film_d + paper_d):
        stock = True
    try: nominal_iso = int(tech.get('nominalIso') or 0)
    except Exception: nominal_iso = 0
    formats = arr(tech.get('formats'))
    sid = str(r.get('sourceId',''))
    source_url = str((sources.get(sid) or {}).get('url',''))
    cur.execute('''INSERT OR REPLACE INTO catalog_products
      (id,name,norm_name,compact_name,manufacturer,categories,roles,aliases,subtitle,
