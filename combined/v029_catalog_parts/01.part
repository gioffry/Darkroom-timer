    tech['paperDilutions'] = pd
    fql.setdefault('sourceId','foma-fomatol-lqn')

con = sqlite3.connect(DB)
cur = con.cursor()
cur.executescript('''
DROP TABLE IF EXISTS catalog_sources;
DROP TABLE IF EXISTS catalog_products;
DROP TABLE IF EXISTS catalog_aliases;
