# canonicalize formatsForFilm helper introduced by v035.
s = s.replace('''        SQLiteDatabase db = helper.getReadableDatabase();\n        try (Cursor c = db.rawQuery(\n                "SELECT time35,time120 FROM times WHERE film_norm=?",\n                new String[]{norm(stripFormat(filmName))})) {''', '''        SQLiteDatabase db = helper.getReadableDatabase();\n        String wantedFilm = stripFormat(filmName);\n        String canonicalFilm = FullCatalogStore.canonicalFilm(wantedFilm);\n        if (canonicalFilm != null) wantedFilm = canonicalFilm;\n        try (Cursor c = db.rawQuery(\n                "SELECT time35,time120 FROM times WHERE film_norm=?",\n                new String[]{norm(wantedFilm)})) {''', 1)
# canonicalize exact time lookup.
s = s.replace('''        String fn = norm(stripFormat(filmName));\n        String dn = norm(developer);''', '''        String filmCanonical = FullCatalogStore.canonicalFilm(stripFormat(filmName));\n        String devCanonical = FullCatalogStore.canonicalDeveloper(developer);\n        String fn = norm(filmCanonical != null ? filmCanonical : stripFormat(filmName));\n        String dn = norm(devCanonical != null ? devCanonical : developer);''', 1)
p.write_text(s, encoding='utf-8')

