# readiness now also guarantees the unified local technical catalog exists.
s = s.replace('scalar(db, "SELECT COUNT(*) FROM films") >= 150;', 'scalar(db, "SELECT COUNT(*) FROM films") >= 150 &&\n                scalar(db, "SELECT COUNT(*) FROM catalog_products") >= 20;', 1)
# canonicalize developer in dilution lookup.
s = s.replace('''    static String[] dilutionsForDeveloper(String developer) {\n        if (!isReady()) return new String[0];\n        LinkedHashSet<String> vals = new LinkedHashSet<>();''', '''    static String[] dilutionsForDeveloper(String developer) {\n        if (!isReady()) return new String[0];\n        String canonical = FullCatalogStore.canonicalDeveloper(developer);\n        if (canonical != null) developer = canonical;\n        LinkedHashSet<String> vals = new LinkedHashSet<>();''', 1)
# canonicalize nominal ISO film.
