plugins {
    id 'com.android.application'
}

android {
    namespace 'it.darkroom.timer'
    compileSdk 34

    defaultConfig {
        applicationId 'it.darkroom.timer'
        minSdk 26
        targetSdk 34
        versionCode 29
        versionName '0.6.3'
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
}
