+    private final class NavButton extends Button {
+        private final int iconKind;
+        private int iconColor = Color.WHITE;
+        private final android.graphics.Paint paint = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
+
+        NavButton(String label, int iconKind) {
+            super(MainActivity.this);
+            this.iconKind = iconKind;
+            setText(label);
+            setTextSize(14);
+            setTypeface(Typeface.DEFAULT, Typeface.BOLD);
+            setAllCaps(false);
+            setGravity(Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL);
+            setPadding(dp(6), dp(8), dp(6), dp(10));
+            setMinHeight(0);
+            setMinimumHeight(0);
+        }
+
+        void setIconColor(int color) {
+            iconColor = color;
+            invalidate();
+        }
+
+        @Override protected void onDraw(android.graphics.Canvas canvas) {
+            super.onDraw(canvas);
+            float cx = getWidth() / 2f;
+            float cy = dp(25);
+            paint.setColor(iconColor);
+            paint.setStrokeWidth(dp(2));
+            paint.setStrokeCap(android.graphics.Paint.Cap.ROUND);
+            paint.setStyle(android.graphics.Paint.Style.STROKE);
+
+            if (iconKind == NAV_ICON_TIMER) {
+                float r = dp(10);
+                canvas.drawCircle(cx, cy, r, paint);
+                canvas.drawLine(cx, cy, cx, cy - dp(6), paint);
+                canvas.drawLine(cx, cy, cx + dp(5), cy + dp(2), paint);
+                canvas.drawLine(cx - dp(3), cy - dp(14), cx + dp(3), cy - dp(14), paint);
+                canvas.drawLine(cx, cy - dp(14), cx, cy - dp(11), paint);
+            } else if (iconKind == NAV_ICON_TEST) {
+                paint.setStyle(android.graphics.Paint.Style.FILL);
+                float cell = dp(5);
+                float gap = dp(3);
+                float total = cell * 3 + gap * 2;
+                float left = cx - total / 2f;
+                float top = cy - (cell * 2 + gap) / 2f;
+                for (int row = 0; row < 2; row++) {
+                    for (int col = 0; col < 3; col++) {
+                        float x = left + col * (cell + gap);
+                        float y = top + row * (cell + gap);
+                        canvas.drawRect(x, y, x + cell, y + cell, paint);
+                    }
+                }
+            } else {
+                for (int row = -1; row <= 1; row++) {
+                    float y = cy + row * dp(7);
+                    canvas.drawLine(cx - dp(12), y, cx + dp(12), y, paint);
+                }
+            }
+        }
+    }
 
