+import base64
+from pathlib import Path
+
+
+def materialize(project: Path):
+    repo_root = Path(__file__).resolve().parent.parent
+    asset_root = repo_root / "assets" / "v064"
+    drawable_root = project / "app" / "src" / "main" / "res" / "drawable-nodpi"
+    drawable_root.mkdir(parents=True, exist_ok=True)
+
+    for stem, out_name in (("splash", "splash_v064.jpg"), ("icon", "app_icon_v064.jpg")):
+        parts = sorted(asset_root.glob(f"{stem}_*.b64"))
+        if not parts:
+            raise RuntimeError(f"Asset v0.6.4 mancante: {stem}")
+        encoded = "".join(p.read_text(encoding="ascii").strip() for p in parts)
+        data = base64.b64decode(encoded, validate=True)
+        target = drawable_root / out_name
+        target.write_bytes(data)
+        print(f"[Darkroom v0.6.4] Asset preparato: {out_name} ({len(data):,} byte)", flush=True)
