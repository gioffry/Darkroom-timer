+    private void showLaunchSplash() {
+        if (darkroomMode) return;
+
+        final View decor = getWindow().getDecorView();
+        decor.setSystemUiVisibility(
+                View.SYSTEM_UI_FLAG_FULLSCREEN
+                        | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
+                        | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY
+                        | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
+                        | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
+                        | View.SYSTEM_UI_FLAG_LAYOUT_STABLE);
+
+        final android.widget.ImageView splash = new android.widget.ImageView(this);
+        splash.setBackgroundColor(Color.BLACK);
+        splash.setImageResource(R.drawable.splash_v064);
+        splash.setScaleType(android.widget.ImageView.ScaleType.FIT_CENTER);
+        splash.setAdjustViewBounds(false);
+        splash.setClickable(true);
+
+        addContentView(splash, new ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.MATCH_PARENT));
+
+        splash.getViewTreeObserver().addOnPreDrawListener(
+                new android.view.ViewTreeObserver.OnPreDrawListener() {
+                    private boolean scheduled = false;
+
+                    @Override public boolean onPreDraw() {
+                        if (scheduled) return true;
+                        scheduled = true;
+                        splash.getViewTreeObserver().removeOnPreDrawListener(this);
+                        splash.postDelayed(() -> {
+                            android.view.ViewParent parent = splash.getParent();
+                            if (parent instanceof ViewGroup) {
+                                ((ViewGroup) parent).removeView(splash);
+                            }
+                            applyDarkroomWindow();
+                        }, 500L);
+                        return true;
+                    }
+                });
