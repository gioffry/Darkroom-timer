@@ -0,0 +1,53 @@
+import base64
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+
+def materialize_icon(project: Path):
+    repo_root = Path(__file__).resolve().parent.parent
+    asset_root = repo_root / "assets" / "v064"
+    parts = sorted(asset_root.glob("icon_*.b64"))
+    if not parts:
+        raise RuntimeError("Asset icona v0.6.4 mancante")
+
+    encoded = "".join(p.read_text(encoding="ascii").strip() for p in parts)
+    jpg_data = base64.b64decode(encoded, validate=True)
+    if not jpg_data.startswith(b"\xff\xd8"):
+        raise RuntimeError("Asset icona v0.6.4 non e' un JPEG valido")
+
+    drawable = project / "app" / "src" / "main" / "res" / "drawable-nodpi"
+    drawable.mkdir(parents=True, exist_ok=True)
+    target = drawable / "ic_launcher.png"
+
+    javac = shutil.which("javac")
+    java = shutil.which("java")
+    if not javac or not java:
+        raise RuntimeError("JDK non disponibile per conversione icona")
+
+    with tempfile.TemporaryDirectory(prefix="darkroom-icon-") as td:
+        td = Path(td)
+        source = td / "IconConvert.java"
+        source.write_text('''
+import java.io.File;
+import java.awt.image.BufferedImage;
+import javax.imageio.ImageIO;
+public final class IconConvert {
+    public static void main(String[] args) throws Exception {
+        BufferedImage img = ImageIO.read(new File(args[0]));
+        if (img == null) throw new IllegalArgumentException("JPEG non leggibile");
+        if (!ImageIO.write(img, "png", new File(args[1])))
+            throw new IllegalStateException("Writer PNG non disponibile");
+    }
+}
+''', encoding="utf-8")
+        src_jpg = td / "icon.jpg"
+        src_jpg.write_bytes(jpg_data)
+        subprocess.run([javac, str(source)], check=True)
+        subprocess.run([java, "-Djava.awt.headless=true", "-cp", str(td), "IconConvert", str(src_jpg), str(target)], check=True)
+
+    png = target.read_bytes()
+    if not png.startswith(b"\x89PNG\r\n\x1a\n"):
+        raise RuntimeError("Conversione icona PNG fallita")
+    print(f"[Darkroom v0.6.4] Icona launcher preparata: {target.name} ({len(png):,} byte)", flush=True)
